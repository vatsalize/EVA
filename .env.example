# ==============================================================================
# EVA — Smart College Event & Venue Management Platform
# Local Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the backend server locally:
#   cp .env.example .env
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Authentication & Security
# Change this secret key in production or staging environments
JWT_SECRET=eva_dev_secret_key_2026_thapar_university_secure
JWT_EXPIRES_IN=7d

# Relational Database Path (SQLite for zero-config local dev)
# Leave blank to use the default: ./database/eva.db
DB_PATH=./database/eva.db

# Cross-Origin Resource Sharing
CORS_ORIGIN=*

# Institutional Policy Configuration
INSTITUTE_DOMAIN=thapar.edu
ALLOW_DEMO_EMAILS=true
